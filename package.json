{
  "name": "bumpfree",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.16 <21 || >=22.3"
  },
  "scripts": {
    "admin": "node scripts/admin.mjs",
    "predev": "node scripts/build-parsers.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/test-schedule-parsers.ts && node --import tsx scripts/test-ics.ts && node --import tsx scripts/test-worker.ts",
    "prebuild": "node scripts/build-parsers.mjs",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "db:local": "wrangler d1 migrations apply bumpfree --local --config worker/wrangler.jsonc",
    "db:remote": "node scripts/wrangler.mjs d1 migrations apply bumpfree --remote --config worker/wrangler.jsonc",
    "deploy:api": "node scripts/wrangler.mjs deploy --config worker/wrangler.jsonc",
    "deploy:web": "node scripts/wrangler.mjs pages deploy out --project-name bumpfree --branch main"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.34.4",
    "ical.js": "2.2.1",
    "lucide-react": "^0.576.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
